# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/docconnect
JWT_SECRET=your_jwt_secret

# Used to encrypt Google Calendar refresh tokens at rest (AES-256-GCM).
# Falls back to JWT_SECRET if unset, but a separate value is recommended.
ENCRYPTION_KEY=your_encryption_key

# Base URL of the running frontend — used for CORS and for building the redirect
# link after the Google Calendar OAuth callback.
CLIENT_URL=http://localhost:5173

# ── Gemini AI ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
# Optional — defaults to gemini-3.6-flash if unset. Google periodically retires
# older model ids; if generation starts failing with a 404 "no longer available"
# error, its message names the current replacement — update this to match, or
# run `node scripts/checkIntegrations.js` to have it surface the suggestion.
GEMINI_MODEL=gemini-3.6-flash

# ── Email (Nodemailer) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="DocConnect <noreply@jeevanchakra.health>"

# ── Google Calendar OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# ── Admin Seed ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@docconnect.com
ADMIN_PASSWORD=admin123

# Password assigned to every doctor created by scripts/importDoctors.js
DATASET_DOCTOR_PASSWORD=Doctor@123
